       "===", "==="}], "="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"finalMatrix", "=", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"ExpToTrig", "[", "step4", "]"}], ",", 
       RowBox[{"TargetFunctions", "->", 
        RowBox[{"{", 
         RowBox[{"Sin", ",", "Cos"}], "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
