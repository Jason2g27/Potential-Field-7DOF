                 RowBox[{"Deep", " ", "trig", " ", "grouping"}]}]}], ",", 
               RowBox[{
               "limit", " ", "FullSimplify", " ", "to", " ", "2.5", "s", " ", 
                "max", " ", "per", " ", "piece"}]}], "*)"}], 
             RowBox[{"stageB", "=", 
              RowBox[{"Collect", "[", 
               RowBox[{"stageA", ",", "trigVars", ",", 
                RowBox[{
                 RowBox[{"TimeConstrained", "[", 
                  RowBox[{
                   RowBox[{"FullSimplify", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"Assumptions", "->", "myAssumptions"}]}], "]"}], ",",
                    "2.5", ",", "#"}], "]"}], "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "stageB"}]}], "]"}]}], "]"}], "&"}], ",", 
       "step3", ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"DistributedContexts", "->", "Automatic"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
